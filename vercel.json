{
  "redirects": [
    { "source": "/links", "destination": "/links/", "statusCode": 301 },
    { "source": "/links/index.html", "destination": "/links/", "statusCode": 301 },
    { "source": "/pricing", "destination": "/pricing.html", "statusCode": 301 },
    { "source": "/privacy", "destination": "/privacy.html", "statusCode": 301 },
    { "source": "/terms", "destination": "/terms.html", "statusCode": 301 },
    { "source": "/:dir+/index.html", "destination": "/:dir+/", "statusCode": 301 },
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/remove-watermark-from-image.html", "destination": "/remove-watermark-from-image/", "statusCode": 301 },
    { "source": "/copy-text-from-image.html", "destination": "/copy-text-from-image/", "statusCode": 301 },
    { "source": "/remove-watermark-from-image", "destination": "/remove-watermark-from-image/", "statusCode": 301 },
    { "source": "/copy-text-from-image", "destination": "/copy-text-from-image/", "statusCode": 301 },
    { "source": "/gemini-watermark-remover", "destination": "/gemini-watermark-remover/", "statusCode": 301 },
    { "source": "/ai-photo-editor", "destination": "/ai-photo-editor/", "statusCode": 301 },
    { "source": "/nano-banana-2-1", "destination": "/nano-banana-2-1/", "statusCode": 301 },
    { "source": "/pixpurge-vs-cleanup", "destination": "/pixpurge-vs-cleanup/", "statusCode": 301 },
    { "source": "/remove-logo-from-image", "destination": "/remove-logo-from-image/", "statusCode": 301 },
    { "source": "/remove-date-stamp-from-photo", "destination": "/remove-date-stamp-from-photo/", "statusCode": 301 },
    { "source": "/ai-watermark-remover", "destination": "/ai-watermark-remover/", "statusCode": 301 },
    { "source": "/remove-caption-from-image", "destination": "/remove-caption-from-image/", "statusCode": 301 },
    { "source": "/chatgpt-watermark-remover", "destination": "/chatgpt-watermark-remover/", "statusCode": 301 },
    { "source": "/blog/how-to-remove-text-from-image", "destination": "/blog/how-to-remove-text-from-image/", "statusCode": 301 },
    { "source": "/pixpurge-vs-picwish", "destination": "/pixpurge-vs-picwish/", "statusCode": 301 },
    { "source": "/pixpurge-vs-watermarkremover", "destination": "/pixpurge-vs-watermarkremover/", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://admin.pixpurge.com/api/v1/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
